# Copy this file to server/.env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000
# Must match the client's origin exactly, or the browser blocks API calls (CORS).
CLIENT_ORIGIN=http://localhost:5173

# Atlas or local MongoDB 5.0+. The database name in the path is the one the app uses.
# Local example: mongodb://127.0.0.1:27017/finance_dashboard
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/finance_dashboard?retryWrites=true&w=majority

# Signs login tokens. At least 32 characters. The server refuses to start with this placeholder;
# generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# How long a login lasts: a whole number followed by s, m, h or d.
JWT_EXPIRES_IN=8h

# Only read by `npm run seed`, which creates this login.
DEMO_USER_EMAIL=analyst@example.com
DEMO_USER_PASSWORD=choose-a-demo-password
DEMO_USER_NAME=Demo Analyst
